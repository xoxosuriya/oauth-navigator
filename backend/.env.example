# Server Environment
ENV=development
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated allowed origins, no wildcard *)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500

# Frontend Base URL (for generating shareable guide permalinks)
FRONTEND_BASE_URL=http://localhost:3000

# Composio Integration (Kept strictly on backend, do not expose)
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1

# LLM Configuration for Live Research Agent (Milestone 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45.0
RESEARCH_ENABLED=true
GEMINI_RESEARCH_ENABLED=false


